{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd website && bun run build",
  "installCommand": "cd website && bun install --frozen-lockfile",
  "outputDirectory": "website/dist",
  "headers": [
    {
      "source": "/install",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/x-shellscript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=300"
        }
      ]
    }
  ]
}
